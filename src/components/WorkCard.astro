---
interface Props {
  kicker: string;
  title: string;
  description: string;
  href?: string;
}

const { kicker, title, description, href } = Astro.props;
const Tag = href ? 'a' : 'article';
---

<Tag class="work-card" href={href} target={href ? '_blank' : undefined} rel={href ? 'noopener noreferrer' : undefined}>
  <span>{kicker}</span>
  <h3>{title}</h3>
  <p>{description}</p>
  {href && <div class="card-cta">Explore <span aria-hidden="true">↗</span></div>}
</Tag>
