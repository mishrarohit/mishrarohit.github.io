---
interface Props {
  title: string;
  event: string;
  year: string;
  visual: string;
  tone: 'green' | 'gold' | 'blue' | 'rose';
  description: string;
  href: string;
  embed?: string;
  image?: string;
}

const { title, event, year, visual, tone, href, embed, image } = Astro.props;
---

<article class="talk-card visual-card talk-card-compact">
  {embed ? (
    <div class="talk-embed">
      <iframe
        src={embed}
        title={title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>
  ) : image ? (
    <a class="talk-image" href={href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${title}`}>
      <img src={image} alt="" loading="lazy" />
    </a>
  ) : (
    <a class={`card-visual tone-${tone}`} href={href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${title}`}>
      <div class="visual-orb"></div>
      <div class="play-mark">↗</div>
      <strong>{visual}</strong>
    </a>
  )}
  <div class="talk-caption">
    <div>
      <h3><a href={href} target="_blank" rel="noopener noreferrer">{title}</a></h3>
      <p class="talk-meta">{event} · {year}</p>
    </div>
    <a class="talk-arrow" href={href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${title}`}>
      ↗
    </a>
  </div>
</article>
