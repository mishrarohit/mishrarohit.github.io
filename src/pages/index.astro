---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WorkCard from '../components/WorkCard.astro';
import TalkCard from '../components/TalkCard.astro';
import Footer from '../components/Footer.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { media, profile, talks, workThemes } from '../data/site';
---

<BaseLayout description="Rohit Mishra is VP Product at Shopify, building commerce infrastructure across payments, tax, risk, money movement, and cross-border commerce.">
  <SiteNav />
  <main>
    <section class="hero section-shell">
      <div class="hero-copy">
        <h1>{profile.headline}</h1>
        <p class="hero-role">VP Product, Shopify</p>
        <p class="hero-intro">
          I build commerce infrastructure at Shopify — payments, tax, risk,
          money movement, and cross-border commerce.
        </p>
        <SocialLinks />
      </div>
      <div class="portrait-card" aria-label="Portrait of Rohit Mishra">
        <img src="/images/rohit.jpeg" alt="Rohit Mishra" />
      </div>
    </section>

    <section class="section-shell split-section">
      <SectionHeading
        eyebrow="What I’ve built"
        title="Payments, tax, and cross-border at Shopify."
        description=""
      />
      <div class="work-grid visual-grid">
        {workThemes.map((theme) => <WorkCard {...theme} />)}
      </div>
    </section>

    <section class="section-shell contrast-section talks-section">
      <SectionHeading
        eyebrow="Talks"
        title="Selected talks and interviews."
      />
      <div class="talk-list visual-grid talks-grid">
        {talks.map((talk) => <TalkCard {...talk} />)}
      </div>
    </section>

    <section class="section-shell media-section">
      <SectionHeading
        eyebrow="Media"
        title="In the press."
      />
      <div class="media-list">
        {media.map((item) => (
          <a class="media-item" href={item.href} target="_blank" rel="noopener noreferrer">
            <span class="media-source">{item.source}</span>
            <span class="media-title">{item.title}</span>
            <span class="media-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
