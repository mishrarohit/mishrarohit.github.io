---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WorkCard from '../components/WorkCard.astro';
import TalkCard from '../components/TalkCard.astro';
import Footer from '../components/Footer.astro';
import { profile, talks, workThemes } from '../data/site';
---

<BaseLayout description="Rohit Mishra is VP Product at Shopify, building payments, cross-border commerce, and merchant infrastructure for millions of businesses.">
  <SiteNav />
  <main>
    <section class="hero section-shell">
      <div class="hero-copy">
        <h1>{profile.headline}</h1>
        <p class="hero-role">VP Product, Shopify</p>
        <p class="hero-intro">
          I build commerce infrastructure for merchants selling everywhere — payments,
          tax, risk, money movement, and cross-border commerce.
        </p>

      </div>
      <div class="portrait-card" aria-label="Portrait of Rohit Mishra">
        <img src="/images/rohit.jpeg" alt="Rohit Mishra" />
      </div>
    </section>

    <section class="section-shell split-section">
      <SectionHeading
        eyebrow="What I’ve built"
        title="Payments, checkout, tax, and cross-border commerce at Shopify."
        description="A few product areas I’ve worked on across payments, checkout, cross-border commerce, and AI-native buying experiences."
      />
      <div class="work-grid visual-grid">
        {workThemes.map((theme) => <WorkCard {...theme} />)}
      </div>
    </section>

    <section class="section-shell split-section contrast-section">
      <SectionHeading
        eyebrow="Speaking"
        title="Talks on payments, global commerce, and AI interfaces."
      />
      <div>
        <div class="talk-list visual-grid">
          {talks.map((talk) => <TalkCard {...talk} />)}
        </div>
        <a class="text-link" href="/talks/">View all talks <span aria-hidden="true">→</span></a>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
