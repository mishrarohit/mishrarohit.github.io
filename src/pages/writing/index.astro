---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Writing" description="Writing from Rohit Mishra on product, commerce, payments infrastructure, and leadership." noindex>
  <SiteNav />
  <main class="page-shell writing-page">
    <SectionHeading
      eyebrow="Writing"
      title="New writing, clean slate."
      description="I’m starting fresh instead of migrating the old archive. Future essays will live here."
    />

    <div class="empty-state">
      <p>
        Topics I expect to write about: product judgment, global commerce,
        payment systems, agentic shopping, and building teams that turn ambiguity
        into leverage.
      </p>
      <a class="text-link" href="mailto:rohit@rohitmishra.me">Send me a note <span aria-hidden="true">→</span></a>
    </div>
  </main>
  <Footer />
</BaseLayout>
