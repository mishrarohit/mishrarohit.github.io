---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Page not found" description="This page does not exist on Rohit Mishra's website." noindex>
  <SiteNav />
  <main class="page-shell writing-page">
    <div class="empty-state">
      <p class="eyebrow">404</p>
      <h1>Page not found.</h1>
      <p>
        I rebuilt this site from scratch and intentionally did not migrate the old blog archive.
        The current site starts here.
      </p>
      <a class="button button-primary" href="/">Go home</a>
    </div>
  </main>
  <Footer />
</BaseLayout>
