---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TalkCard from '../components/TalkCard.astro';
import Footer from '../components/Footer.astro';
import { talks } from '../data/site';
---

<BaseLayout title="Talks" description="Talks and presentations by Rohit Mishra on payments, global commerce, Shopify Markets, Shop Pay, and AI commerce.">
  <SiteNav />
  <main class="page-shell">
    <SectionHeading
      eyebrow="Talks"
      title="Selected talks and interviews."
      description="Public conversations on commerce infrastructure, local payment methods, global expansion, and AI-powered shopping."
    />
    <div class="talk-list talk-list-large visual-grid">
      {talks.map((talk) => <TalkCard {...talk} />)}
    </div>
  </main>
  <Footer />
</BaseLayout>
